# Local .terraform directory (contains provider binaries and modules)
.terraform/

# .tfstate files (contain sensitive data and infrastructure secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude any .tfvars files (these often contain sensitive credentials/variables)
*.tfvars
*.tfvars.json

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files for specific environments if strictly necessary (comment out if not)
# !example_override.tf

# Include trace logs for debugging
terraform.tfvars.json

# .terraform.lock.hcl (OPTIONAL)
# Some teams choose to track this to ensure consistent provider versions.
# Remove the '#' below if you want to ignore it.
.terraform.lock.hcl
